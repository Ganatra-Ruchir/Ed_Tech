# Pooled PostgreSQL URL used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct PostgreSQL URL used by Prisma migrations and the seed script.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to sign session JWTs. Generate a unique value for production.
AUTH_SECRET="dev-only-secret-change-me-in-production-9f3a7c2e1b6d4f80"

# Optional. When set, submission files and generated PDF reports are stored
# in Vercel Blob instead of local disk (data/uploads, data/reports). Vercel
# sets this automatically once you attach a Blob store to your project.
# BLOB_READ_WRITE_TOKEN=

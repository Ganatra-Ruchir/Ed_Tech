// Student Progress & Evaluation Platform - data model
// Note: SQLite backend -> no native scalar lists, so multi-value relations
// (files, questions, answers, batch memberships) are modeled as join tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum SubmissionStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  NEEDS_REVISION
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
}

enum KPIScope {
  STUDENT
  BATCH
  COHORT
}

enum ReportScope {
  STUDENT
  BATCH
  COHORT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isCC         Boolean  @default(false)
  branch       String?
  college      String?
  facultyType  String?
  studentNumber String?
  enrollmentNumber String?
  ccName       String?
  scName       String?
  profileImageUrl String?
  profileImageStorageKey String?
  dateOfBirth  DateTime?
  joiningDate  DateTime?
  salary       Float?
  createdAt    DateTime @default(now())

  batchMemberships UserBatch[]
  submissions      Submission[]      @relation("StudentSubmissions")
  testResponses    TestResponse[]
  testsCreated     Test[]            @relation("FacultyTests")
  evidenceAdded    Evidence[]        @relation("FacultyEvidence")
  feedbackGiven    Feedback[]        @relation("FacultyFeedback")
  auditLogs        AuditLog[]
  announcements    Announcement[]
  announcementReceipts AnnouncementReceipt[]
  announcementComments AnnouncementComment[]
  assignmentsCreated Assignment[] @relation("FacultyAssignments")
  attendanceRecords Attendance[]
  staffAttendance   StaffAttendance[]
  interventions      Intervention[] @relation("StudentInterventions")
  interventionsRaised Intervention[] @relation("RaisedInterventions")
  privateNotes       PrivateNote[]  @relation("StudentPrivateNotes")
  privateNotesAuthored PrivateNote[] @relation("AuthorPrivateNotes")
  conversationMemberships ConversationMember[]
  messagesSent Message[] @relation("SentMessages")
  conversationsCreated Conversation[] @relation("CreatedConversations")

  @@index([role])
}

model Batch {
  id         String   @id @default(cuid())
  name       String
  department String
  semester   String
  createdAt  DateTime @default(now())

  members       UserBatch[]
  submissions   Submission[]
  tests         Test[]
  kpis          KPI[]
  reports       Report[]
  announcements Announcement[]
  assignments   Assignment[]
  attendance    Attendance[]

  @@unique([name, department, semester])
}

model UserBatch {
  id      String @id @default(cuid())
  userId  String
  batchId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([userId, batchId])
  @@index([batchId])
}

model Conversation {
  id          String   @id @default(cuid())
  title       String?
  isGroup     Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Cascade)
  members ConversationMember[]
  messages Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id         String @id @default(cuid())
  messageId  String
  fileName   String
  fileUrl    String
  storageKey String
  fileType   String
  fileSize   Int

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Assignment {
  id                  String   @id @default(cuid())
  batchId             String
  createdByFacultyId  String
  title               String
  description         String?
  dueAt               DateTime?
  attachmentUrl       String?
  attachmentStorageKey String?
  attachmentName      String?
  attachmentType      String?
  attachmentSize      Int?
  createdAt           DateTime @default(now())

  batch              Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy          User        @relation("FacultyAssignments", fields: [createdByFacultyId], references: [id], onDelete: Cascade)
  submissions        Submission[]

  @@index([batchId, createdAt])
  @@index([createdByFacultyId])
}

model Attendance {
  id        String   @id @default(cuid())
  batchId   String
  studentId String
  date      DateTime
  status    String   @default("PRESENT")
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt DateTime @default(now())

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId, date])
  @@index([batchId, date])
  @@index([studentId, date])
}

model StaffAttendance {
  id         String    @id @default(cuid())
  facultyId  String
  date       DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  isLate     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  faculty User @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([facultyId, date])
  @@index([date])
}

/** Singleton row (fixed id) holding office-hours config used to flag late
 * faculty check-ins. Read/written only from src/lib/staff-attendance.ts. */
model AttendanceSettings {
  id              String   @id @default("singleton")
  officeStartTime String   @default("09:30")
  updatedAt       DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  batchId   String
  facultyId String
  title     String
  body      String
  attachmentUrl String?
  attachmentStorageKey String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  category  String   @default("GENERAL")
  pinned    Boolean  @default(false)
  requireAck Boolean @default(false)
  allowComments Boolean @default(true)
  scheduledAt DateTime?
  createdAt DateTime @default(now())

  batch    Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  faculty  User  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  receipts AnnouncementReceipt[]
  comments AnnouncementComment[]

  @@index([batchId, createdAt])
  @@index([pinned])
}

/// One row per (announcement, recipient). `seenAt` is set the first time the
/// recipient loads the stream; `acknowledgedAt` only when they click the
/// Acknowledge button on an announcement whose requireAck is true. This is how
/// "86/92 seen · 72 acknowledged" is computed — from real receipts, not guesses.
model AnnouncementReceipt {
  id             String    @id @default(cuid())
  announcementId String
  userId         String
  seenAt         DateTime  @default(now())
  acknowledgedAt DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

/// A reply on an announcement's discussion thread. Visible to everyone who can
/// see the announcement; gated by the announcement's allowComments flag.
model AnnouncementComment {
  id             String   @id @default(cuid())
  announcementId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
}

model Submission {
  id        String           @id @default(cuid())
  studentId String
  batchId   String
  assignmentId String?
  title     String
  notes     String?
  status    SubmissionStatus @default(SUBMITTED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  reviewedAt DateTime?

  student  User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  batch    Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignment Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  files    SubmissionFile[]
  evidence Evidence[]
  feedback Feedback[]

  @@index([studentId])
  @@index([batchId])
  @@index([status])
  @@index([assignmentId])
}

model SubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int      @default(0)
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Test {
  id                  String    @id @default(cuid())
  createdByFacultyId  String
  batchId             String
  title               String
  description         String?
  publishedAt         DateTime?
  dueAt               DateTime?
  createdAt           DateTime  @default(now())

  createdBy User           @relation("FacultyTests", fields: [createdByFacultyId], references: [id], onDelete: Cascade)
  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questions Question[]
  responses TestResponse[]

  @@index([batchId])
}

model Question {
  id            String       @id @default(cuid())
  testId        String
  type          QuestionType
  text          String
  optionsJson   String? // JSON-encoded string[] for MCQ options
  correctAnswer String?
  order         Int          @default(0)
  required      Boolean      @default(true)
  points        Int          @default(1)

  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([testId])
}

model TestResponse {
  id          String    @id @default(cuid())
  testId      String
  studentId   String
  score       Float?
  maxScore    Float?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  test     Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  student  User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers  Answer[]
  evidence Evidence[]
  feedback Feedback[]

  @@unique([testId, studentId])
  @@index([studentId])
}
model Answer {
  id             String  @id @default(cuid())
  testResponseId String
  questionId     String
  answerText     String?
  isCorrect      Boolean?

  testResponse TestResponse @relation(fields: [testResponseId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testResponseId, questionId])
  @@index([questionId])
}

model Evidence {
  id               String   @id @default(cuid())
  submissionId     String?
  testResponseId   String?
  tag              String
  notes            String?
  addedByFacultyId String
  createdAt        DateTime @default(now())

  submission   Submission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testResponse TestResponse? @relation(fields: [testResponseId], references: [id], onDelete: Cascade)
  faculty      User          @relation("FacultyEvidence", fields: [addedByFacultyId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([testResponseId])
}

model Feedback {
  id             String   @id @default(cuid())
  submissionId   String?
  testResponseId String?
  facultyId      String
  comment        String
  createdAt      DateTime @default(now())

  submission   Submission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testResponse TestResponse? @relation(fields: [testResponseId], references: [id], onDelete: Cascade)
  faculty      User          @relation("FacultyFeedback", fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([testResponseId])
}

model KPI {
  id         String   @id @default(cuid())
  // Groups rows belonging to the same metric series ("scope:batchId:studentId:metricName")
  // so "latest value" and "trend over time" can both be queried from one append-only table.
  key        String
  scope      KPIScope
  batchId    String?
  studentId  String?
  metricName String
  value      Float
  computedAt DateTime @default(now())

  batch Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([key, computedAt])
  @@index([batchId])
  @@index([studentId])
  @@index([metricName])
}

model Report {
  id          String      @id @default(cuid())
  scope       ReportScope
  studentId   String?
  batchId     String?
  generatedAt DateTime    @default(now())
  pdfPath     String

  batch Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([batchId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  entityType   String
  entityId     String
  metadataJson String?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum RiskLevel {
  NORMAL
  WATCH
  AT_RISK
  CRITICAL
}

enum InterventionType {
  WARNING
  FACULTY_MENTORING
  CC_MEETING
  PARENT_COMMUNICATION
  REMEDIAL_ASSIGNMENT
  REVISION
  ATTENDANCE_COUNSELLING
  ACADEMIC_SUPPORT
}

enum InterventionStatus {
  OPEN
  IN_PROGRESS
  FOLLOW_UP
  RESOLVED
}

/// An action taken when a student needs academic attention. Created by
/// faculty/CC/admin off the back of a risk assessment; `riskLevelAtCreation`
/// and `reasonsJson` snapshot *why* it was raised so outcomes stay auditable
/// even after the student's live risk changes.
model Intervention {
  id                  String             @id @default(cuid())
  studentId           String
  raisedById          String
  type                InterventionType
  status              InterventionStatus @default(OPEN)
  reason              String
  action              String?
  notes               String?
  riskLevelAtCreation RiskLevel?
  reasonsJson         String?
  followUpAt          DateTime?
  outcome             String?
  resolvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  student  User @relation("StudentInterventions", fields: [studentId], references: [id], onDelete: Cascade)
  raisedBy User @relation("RaisedInterventions", fields: [raisedById], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([status])
  @@index([raisedById])
}

/// Faculty/CC-only observations about a student. Never exposed to students —
/// every read path must filter by the viewer's role server-side.
model PrivateNote {
  id        String   @id @default(cuid())
  studentId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  student User @relation("StudentPrivateNotes", fields: [studentId], references: [id], onDelete: Cascade)
  author  User @relation("AuthorPrivateNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}
